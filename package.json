{
  "name": "xcode-editor",
  "productName": "Xcode",
  "version": "1.0.5",
  "description": "Xcode — a fast, lightweight personal code editor",
  "main": "./out/main/index.js",
  "author": "masudranadev51",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:icon": "node scripts/gen-icon.mjs",
    "dist": "electron-vite build && electron-builder --win nsis",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "release": "electron-vite build && electron-builder --publish always"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^32.2.6",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^2.1.8",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dictionary-en": "^4.0.0",
    "dompurify": "^3.2.4",
    "electron-updater": "^6.3.9",
    "emmet-monaco-es": "^5.5.0",
    "marked": "^14.1.3",
    "monaco-editor": "^0.52.2",
    "nspell": "^2.1.5"
  }
}
